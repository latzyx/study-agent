# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Authentication
# Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated user IDs or usernames allowed to access /api/v1/admin/*.
ADMIN_USER_IDS=
ADMIN_USERNAMES=admin

# Database
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/study_agent

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# Model profiles: provider:model-id
LLM_MODEL_FAST=lmstudio:qwen-local
LLM_MODEL_GENERAL=lmstudio:qwen-local
LLM_MODEL_REASONING=openai:gpt-5-mini
LLM_MODEL_VISION=openai:gpt-5-mini
LLM_MODEL_FALLBACK=anthropic:claude-sonnet-4-5

# Cloud providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local OpenAI-compatible providers
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=local-vllm
