# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=http://localhost:5173
# Only enable when requests always pass through a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Authentication
# Production requires at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=study-agent
JWT_AUDIENCE=study-agent-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Comma-separated user IDs or usernames allowed to access /api/v1/admin/*.
ADMIN_USER_IDS=
ADMIN_USERNAMES=admin

# Local in-process rate limits
# Multi-instance deployments should replace the limiter storage with Redis or another shared backend.
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_REFRESH_RATE_LIMIT_MAX=30
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
CHAT_MAX_CONCURRENT_PER_USER=2
CHAT_MAX_CONCURRENT_PER_SESSION=1
RATE_LIMIT_MAX_KEYS=10000

# Database
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/study_agent
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_SECONDS=20
DB_CONNECT_TIMEOUT_SECONDS=10
DB_SHUTDOWN_TIMEOUT_SECONDS=5
HEALTHCHECK_DB_TIMEOUT_MS=1500

# AI SDK trace persistence
AI_TRACE_ENABLED=true
# Leave unset to record payloads in development/test and disable payloads in production.
# AI_TRACE_RECORD_INPUTS=false
# AI_TRACE_RECORD_OUTPUTS=false
AI_TRACE_MAX_SNAPSHOT_CHARS=20000
AI_TRACE_RETENTION_DAYS=30

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

# Model profiles: provider:model-id
LLM_MODEL_FAST=lmstudio:qwen-local
LLM_MODEL_GENERAL=lmstudio:qwen-local
LLM_MODEL_REASONING=openai:gpt-5-mini
LLM_MODEL_VISION=openai:gpt-5-mini
LLM_MODEL_FALLBACK=anthropic:claude-sonnet-4-5

# Cloud providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local OpenAI-compatible providers
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=local-vllm
